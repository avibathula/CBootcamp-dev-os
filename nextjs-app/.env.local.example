# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=                 # Project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=            # anon/public key — safe for the browser
SUPABASE_SERVICE_ROLE_KEY=                # SERVER ONLY — bypasses RLS, never expose to the client

# OpenAI — platform.openai.com/api-keys
OPENAI_API_KEY=                           # SERVER ONLY — GPT-4o extraction + chat calls

# Upstash Redis — console.upstash.com (used for /api/process-contract and /api/chat rate limiting)
UPSTASH_REDIS_REST_URL=                   # SERVER ONLY — REST API URL for your Redis database
UPSTASH_REDIS_REST_TOKEN=                 # SERVER ONLY — REST API token for your Redis database

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000 # Base URL used for redirects and absolute links
